# Soluna environment template
#
# Do not put real secrets in this file. Copy the relevant values into local
# environment files or Supabase secrets.

# Expo public client values
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_USE_MOCK_DATA=false
# Email shown for data-export / account-deletion requests (Profile → Account)
EXPO_PUBLIC_SUPPORT_EMAIL=support@soluna.app

# Supabase Edge Function secrets
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Birth place resolution
GOOGLE_MAPS_API_KEY=

# Astrology provider — AstrologyAPI is the production provider.
# Set ASTROLOGY_API_KEY as a Supabase Edge Function secret (never client-side).
ASTROLOGY_PROVIDER=astrologyapi
ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com
ASTROLOGY_API_KEY=
# Only if your AstrologyAPI plan uses userId + key (HTTP Basic) in addition to the header.
ASTROLOGY_API_USER_ID=
# Dev only: "true" allows the in-app estimate when no provider is configured.
# MUST be unset/false in production so chart placements are never fabricated.
ASTROLOGY_ALLOW_APPROXIMATION=false
# Alternative providers (ignored when ASTROLOGY_PROVIDER=astrologyapi)
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# LLM provider
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Billing
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Internal scheduled/background Edge Function guard
SOLUNA_INTERNAL_FUNCTION_SECRET=

# Push notifications
EXPO_ACCESS_TOKEN=

# Optional operations
SENTRY_DSN=
POSTHOG_API_KEY=
RESEND_API_KEY=
