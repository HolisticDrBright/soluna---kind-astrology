# Soluna environment template
#
# Do not put real secrets in this file. Copy the relevant values into local
# environment files or Supabase secrets.

# Expo public client values
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# ─── Client mode flags (all read by expo/lib/config.ts) ──────────────────────
# Canonical demo switch. true = render fake sample content (expo/constants/demoData.ts)
# for screenshots & local testing. Production / TestFlight / App Store builds MUST
# keep this false — live mode builds from real backend data and never shows fake
# user data (see expo/lib/config.ts + runtimeMode.ts).
EXPO_PUBLIC_ENABLE_DEMO_MODE=false
# Legacy alias for the above (still honoured for back-compat). Prefer ENABLE_DEMO_MODE.
EXPO_PUBLIC_USE_MOCK_DATA=false
# Allow canned sample readings (daily / tarot / chat). Demo only — keep false in prod.
EXPO_PUBLIC_ENABLE_MOCK_READINGS=false
# Allow the RevenueCat *test* key when no real key is set. Keep false in prod so a
# missing key surfaces an honest "billing unavailable" state (never a sandbox key).
EXPO_PUBLIC_ENABLE_BILLING_FALLBACK=false
# Email shown for data-export / account-deletion requests (Profile → Account)
EXPO_PUBLIC_SUPPORT_EMAIL=support@soluna.app
# RevenueCat PUBLIC SDK keys (publishable — safe in the client). Set the
# platform-specific keys in production. (Legacy *_API_KEY_IOS/ANDROID still honoured.)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Entitlement identifier from the RevenueCat dashboard (default: premium)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
# Sentry DSN for the app (a DSN is publishable — it only allows sending events)
EXPO_PUBLIC_SENTRY_DSN=

# Supabase Edge Function secrets
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Birth place resolution
GOOGLE_MAPS_API_KEY=

# Astrology provider — AstrologyAPI is the production provider.
# Set ASTROLOGY_API_KEY as a Supabase Edge Function secret (never client-side).
ASTROLOGY_PROVIDER=astrologyapi
ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com
ASTROLOGY_API_KEY=
# Only if your AstrologyAPI plan uses userId + key (HTTP Basic) in addition to the header.
ASTROLOGY_API_USER_ID=
# Dev only: "true" allows the in-app estimate when no provider is configured.
# MUST be unset/false in production so chart placements are never fabricated.
ASTROLOGY_ALLOW_APPROXIMATION=false
# Transits: Moon phase is always computed deterministically (no key needed). Full
# transit-to-natal data is OFF until you confirm your plan's transit endpoint —
# set both to enable; otherwise the app uses Moon phase only (never fabricated).
ASTROLOGY_TRANSITS_ENABLED=false
ASTROLOGY_TRANSITS_ENDPOINT=
# Alternative providers (ignored when ASTROLOGY_PROVIDER=astrologyapi)
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# BaZi / Four Pillars — true, provider-backed Eastern depth (FreeAstroAPI).
# Backend-only secret. Without it, the app shows the lightweight Chinese zodiac
# and an honest "BaZi unavailable" state — BaZi is NEVER fabricated.
BAZI_PROVIDER=freeastroapi
BAZI_API_BASE_URL=https://api.freeastroapi.com
BAZI_API_KEY=
# Optional: exact route if your plan differs from the default (/bazi).
BAZI_API_ENDPOINT=
# Feature flags (default on); true solar time needs a birth location.
BAZI_ENABLE_TRUE_SOLAR_TIME=true
BAZI_ENABLE_LUCK_CYCLES=true
BAZI_ENABLE_COMPATIBILITY=true

# LLM provider (powers Soluna chat + daily readings)
# LLM_PROVIDER: "anthropic" (default if unset) or "openai".
LLM_PROVIDER=anthropic
# API key. If LLM_API_KEY is empty, the provider key below is used instead:
#   anthropic -> ANTHROPIC_API_KEY,  openai -> OPENAI_API_KEY.
# If NONE of these is set, chat + daily readings fall back to safe canned text
# (this is the #1 cause of "Soluna chat isn't working").
LLM_API_KEY=
# Model id. Leave blank to use the per-provider default
#   (anthropic -> claude-sonnet-4-6,  openai -> gpt-5-mini).
# Only set this to a CURRENT, valid model id — a stale/typo'd id fails every call.
LLM_MODEL=
LLM_BASE_URL=
# Optional Anthropic beta header(s), comma-separated. Leave BLANK in normal use.
# Do NOT put a "no-retention" value here — zero-data-retention is an org-level
# setting on your Anthropic account, not a request header, and an unrecognized
# beta value makes every call fail.
LLM_ANTHROPIC_BETA=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Billing (server-side)
# Authorization the RevenueCat webhook must send: "Authorization: Bearer <secret>"
REVENUECAT_WEBHOOK_SECRET=
# RevenueCat SECRET REST API key (server only; optional — the client SDK uses
# EXPO_PUBLIC_REVENUECAT_API_KEY above, not this)
REVENUECAT_API_KEY=

# Internal scheduled/background Edge Function guard
SOLUNA_INTERNAL_FUNCTION_SECRET=

# Push notifications (server-side; send-push fails closed without this)
EXPO_ACCESS_TOKEN=
# Also set expo.extra.eas.projectId in app.json (run `eas init`) so the client
# can fetch an Expo push token in standalone builds.

# Optional operations — SENTRY_DSN here is for Edge Functions (server side).
# The app itself uses EXPO_PUBLIC_SENTRY_DSN above.
SENTRY_DSN=
POSTHOG_API_KEY=
RESEND_API_KEY=

# Optional endpoint overrides for the newer FreeAstroAPI surfaces (defaults are
# correct; set only if the provider moves them).
# VEDIC_DASHA_API_ENDPOINT=/api/v2/vedic/dasha
# VEDIC_STRENGTH_API_ENDPOINT=/api/v2/vedic/strength
# VEDIC_MATCH_API_ENDPOINT=/api/v2/vedic/match
# SOLAR_RETURN_API_ENDPOINT=/api/v1/western/solar/calculate
