# Soluna environment template
#
# Do not put real secrets in this file. Copy the relevant values into local
# environment files or Supabase secrets.

# Expo public client values
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_USE_MOCK_DATA=false

# Supabase Edge Function secrets
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Birth place resolution
GOOGLE_MAPS_API_KEY=

# Astrology provider
ASTROLOGY_PROVIDER=custom
ASTROLOGY_API_BASE_URL=
ASTROLOGY_API_KEY=
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
ASTROLOGY_API_USER_ID=

# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Billing
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Push notifications
EXPO_ACCESS_TOKEN=

# Optional operations
SENTRY_DSN=
POSTHOG_API_KEY=
RESEND_API_KEY=
