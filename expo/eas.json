{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_ENABLE_DEMO_MODE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_ENABLE_DEMO_MODE": "false"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_MOCK_READINGS": "false",
        "EXPO_PUBLIC_ENABLE_BILLING_FALLBACK": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6785301774"
      }
    }
  }
}
