# Soluna frontend env. Copy to .env.local (gitignored). EXPO_PUBLIC_* vars are
# inlined into the app by the Expo bundler.

# Supabase project
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Edge Functions base (optional; derived from SUPABASE_URL if omitted).
# Local dev: http://127.0.0.1:54321/functions/v1
EXPO_PUBLIC_FUNCTIONS_URL=

# RevenueCat public SDK key (platform-specific; set the iOS or Android key).
EXPO_PUBLIC_REVENUECAT_KEY=

# Dev only: set to "false"/"0" to use the real backend. Defaults to true (mock
# data) so the app runs without a backend. Production builds IGNORE this and
# always use the real backend.
EXPO_PUBLIC_USE_MOCK_DATA=true

# Optional client-side analytics / crash reporting (only if integrated).
# These ARE shipped in the app bundle, so use public/DSN keys only.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
