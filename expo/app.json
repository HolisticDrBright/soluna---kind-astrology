{
  "expo": {
    "name": "Soluna",
    "slug": "soluna-kind-astrology",
    "owner": "holisticdrbright",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soluna",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1635"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.holisticdrbright.soluna",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Soluna can use your location to help find your birthplace when you set up your chart. You can also type it in instead.",
        "NSPhotoLibraryUsageDescription": "Soluna needs access to your photos only if you choose a profile image.",
        "NSCameraUsageDescription": "Soluna needs camera access only if you choose to take a profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1635"
      },
      "package": "com.holisticdrbright.soluna",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7f8c61fd-28f3-4ac2-85dc-d8bb9933aad5"
      }
    }
  }
}
