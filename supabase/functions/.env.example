# Soluna BACKEND secrets — set in prod via:
#   supabase secrets set --env-file ./supabase/functions/.env
# For local dev, copy to supabase/functions/.env (gitignored). SUPABASE_* are
# auto-injected by the Edge runtime locally, so you only need the app secrets.
#
# These are SERVER-SIDE secrets. Never expose them to the Expo client (only
# EXPO_PUBLIC_* vars in expo/.env.example reach the app bundle).

# ─── Astrology provider ────────────────────────────────────────────
# Pick a provider; if none is configured the engine uses its in-process MIT
# ephemeris library (honest "verified_library" precision, never fake-exact).
ASTROLOGY_PROVIDER=                 # prokerala | astrologyapi | custom (auto-detected if blank)

# Prokerala (OAuth2 client credentials) — https://api.prokerala.com/
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# AstrologyAPI.com (HTTP Basic: userId:apiKey) — https://astrologyapi.com/
ASTROLOGY_API_USER_ID=
ASTROLOGY_API_KEY=

# Custom provider: a JSON endpoint you control (POST {date,time,latitude,...}/natal).
ASTROLOGY_API_BASE_URL=

# ─── Google Maps (Places + Geocoding + Time Zone) ──────────────────
# Used server-side (via the `geo` Edge Function) for birth-city autocomplete and
# to resolve a place + birth date to lat/lng + a DST-correct IANA timezone.
# Keep this a BACKEND secret — it is proxied, never shipped to the client.
GOOGLE_MAPS_API_KEY=

# ─── LLM (no-training / zero-retention endpoint ONLY) ──────────────
LLM_PROVIDER=anthropic              # anthropic | openai
ANTHROPIC_API_KEY=                  # used when LLM_PROVIDER=anthropic
OPENAI_API_KEY=                     # used when LLM_PROVIDER=openai
# Optional: generic key (back-compat) + model/base overrides.
LLM_API_KEY=
LLM_MODEL=                          # default: claude-sonnet-4-6 (anthropic) / gpt-4o (openai)
LLM_BASE_URL=                       # e.g. a zero-retention gateway

# ─── Billing (RevenueCat) ──────────────────────────────────────────
REVENUECAT_API_KEY=                 # for server-side subscriber reconciliation
REVENUECAT_WEBHOOK_SECRET=          # Authorization header the webhook must present

# ─── Push (Expo) ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── App secrets ───────────────────────────────────────────────────
# 32-byte key, base64-encoded, used to encrypt sensitive columns (e.g. full
# birth name). Generate:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Shared secret the pg_cron jobs send as `x-cron-secret` to cron functions.
CRON_SECRET=

# ─── Optional: observability + email (only if integrated) ──────────
SENTRY_DSN=
POSTHOG_API_KEY=
RESEND_API_KEY=

# ─── Auto-injected by Supabase Edge runtime (do NOT set manually) ──
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
