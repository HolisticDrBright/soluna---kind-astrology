# Soluna backend secrets — set in prod via:  supabase secrets set --env-file ./supabase/functions/.env
# For local dev, copy to supabase/functions/.env (gitignored). SUPABASE_* are
# auto-injected by the Edge runtime locally, so you only need the app secrets.

# ─── Astrology / ephemeris ─────────────────────────────────────────
# Primary engine = hosted API; if unset, the engine falls back to the
# MIT circular-natal-horoscope-js library (no network, slightly less precise).
ASTROLOGY_API_BASE_URL=
ASTROLOGY_API_KEY=

# ─── LLM (no-training / zero-retention endpoint ONLY) ──────────────
LLM_PROVIDER=anthropic           # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Optional override of the API base (e.g. a zero-retention gateway).
LLM_BASE_URL=

# ─── Geocoding + historical timezone (birth place -> lat/lng/tz) ───
GEOCODER_API_KEY=
TIMEZONE_DB_API_KEY=

# ─── Billing (RevenueCat) ──────────────────────────────────────────
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ─── Push (Expo) ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── App secrets ───────────────────────────────────────────────────
# 32-byte key, base64-encoded, used to encrypt sensitive columns
# (e.g. full birth name). Generate:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Shared secret the pg_cron jobs send as `x-cron-secret` to cron functions.
CRON_SECRET=
SENTRY_DSN=

# ─── Auto-injected by Supabase Edge runtime (do NOT set manually) ──
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
